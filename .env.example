# ---------------------------------------------------------------
# Copie este arquivo para ".env" e preencha com os seus dados.
# O ".env" NÃO vai para o GitHub (está no .gitignore), porque
# guarda senhas. Este ".env.example" vai, para mostrar o modelo.
# ---------------------------------------------------------------

# Porta em que a API vai rodar (http://localhost:3000)
PORT=3000

# Endereço público da API. É usado para montar o link das imagens
# dos produtos (ex.: http://localhost:3000/media/produtos/zoro.jpg)
BASE_URL=http://localhost:3000

# Banco de dados MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=zeroonze

# Segredo usado para assinar os tokens JWT.
# Use um texto longo e aleatório. Quem souber esse segredo
# consegue criar tokens falsos, então nunca publique o seu.
JWT_SECRET=troque-por-um-texto-longo-e-aleatorio

# Por quanto tempo o token vale (1d = 1 dia, 2h = 2 horas)
JWT_EXPIRES_IN=1d
